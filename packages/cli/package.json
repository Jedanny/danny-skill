{
  "name": "@dannyok/cli",
  "version": "1.0.0",
  "description": "Rust N-API powered CLI for danny-skill",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jedanny/danny-skill.git",
    "directory": "packages/cli"
  },
  "bin": {
    "danny-skill": "bin/danny-skill.mjs"
  },
  "main": "index.mjs",
  "files": [
    "bin/",
    "index.mjs",
    "danny-skill.mjs",
    "dist/",
    "*.node",
    "Cargo.toml",
    "Cargo.lock",
    "src/",
    "templates/",
    "README.md"
  ],
  "scripts": {
    "prepare:package": "node danny-skill.mjs package --target-root . --profile full",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "artifacts": "napi artifacts",
    "prepublishOnly": "napi prepublish -t npm"
  },
  "napi": {
    "binaryName": "danny_skill_cli",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
